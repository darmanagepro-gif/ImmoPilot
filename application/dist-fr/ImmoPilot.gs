  if (inc && !others.length && ["RESOLVED", "CLOSED", "CANCELLED"].indexOf(inc.status) < 0) dbUpdate_("IncidentsV4", inc.incidentId, { status: "RESOLVED", resolvedAt: nowIso_(), updatedAt: nowIso_(), updatedBy: p.email });
