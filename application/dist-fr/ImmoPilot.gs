  if (!subSchemaReady_()) migSchemaSync_(); // colonnes nouvelles (opération additive)
  const plan = dbGet_("SubscriptionPlans", "PRO");
  {
    // Ancienne démo : l'agence avait son propre abonnement → clos, et ses règlements fictifs annulés (rien n'est supprimé).
    dbAll_("Subscriptions").filter(function (x) { return String(x.organizationId) === String(agencyOrg.organizationId) && x.status !== "CANCELLED"; }).forEach(function (x) {
      dbUpdate_("Subscriptions", x.subscriptionId, { status: "CANCELLED", canceledAt: nowIso_(), updatedAt: nowIso_(), updatedBy: sp.email });
      dbAll_("Payments").filter(function (y) { return y.refType === "SUBSCRIPTION" && String(y.refId) === String(x.subscriptionId) && y.status === "RECORDED"; })
        .forEach(function (y) { dbUpdate_("Payments", y.paymentId, { status: "VOID", voidedAt: nowIso_(), voidedBy: sp.email, note: "Démo : agence passée en option de l'abonnement du propriétaire" }); });
      out.agencySubscriptionClosed = true;
    });
    dbAll_("Subscriptions").filter(function (x) { return String(x.organizationId) === String(ownerOrg.organizationId) && x.status !== "CANCELLED" && !num_(x.agencyOptionPrice); })
      .forEach(function (x) { dbUpdate_("Subscriptions", x.subscriptionId, { agencyOptionPrice: dm_(DEMO_AGENCY_OPTION_), updatedAt: nowIso_() }); });
  }
  [ownerOrg].forEach(function (org) {
    if (!plan || dbAll_("Subscriptions").some(function (x) { return String(x.organizationId) === String(org.organizationId); })) return;
    const price = num_(plan.price) + dm_(DEMO_AGENCY_OPTION_), subId = newId_("sub"), paidThrough = addMonthsStr_(start, 12);
    dbInsert_("Subscriptions", { subscriptionId: subId, organizationId: org.organizationId, planCode: "PRO", status: "ACTIVE", startDate: start, nextDueDate: paidThrough, periodEnd: paidThrough,
      trialEnd: "", cancelAtPeriodEnd: false, price: num_(plan.price), agencyOptionPrice: dm_(DEMO_AGENCY_OPTION_), currency: plan.currency || cur_(), periodicity: plan.periodicity || "MONTHLY", paidThrough: paidThrough,
      createdAt: start + "T09:00:00.000Z", createdBy: sp.email, updatedAt: nowIso_(), updatedBy: sp.email });
    dbUpdate_("Organizations", org.organizationId, { planCode: "PRO", updatedAt: nowIso_() });
    const rows = [];
    for (let k = 0; k < 6; k++) {
      const d = addMonthsStr_(start, k); if (d > today) break;
      rows.push({ paymentId: newId_("pay"), organizationId: org.organizationId, propertyId: "", kind: "SUBSCRIPTION", refType: "SUBSCRIPTION", refId: subId, direction: "IN", amount: price, currency: cur_(),
        method: "TRANSFER", paidAt: d, reference: "Abonnement Pro + option 1 agence " + d.slice(0, 7), status: "RECORDED", reconciled: true, note: "1 période — donnée de démonstration", recordedBy: sp.email, createdAt: d + "T10:00:00.000Z" });
    }
    const semi = addMonthsStr_(start, 6) > today ? today : addMonthsStr_(start, 6);
    rows.push({ paymentId: newId_("pay"), organizationId: org.organizationId, propertyId: "", kind: "SUBSCRIPTION", refType: "SUBSCRIPTION", refId: subId, direction: "IN", amount: price * 6, currency: cur_(),
      method: "TRANSFER", paidAt: semi, reference: "Abonnement Pro — règlement semestriel", status: "RECORDED", reconciled: true, note: "6 périodes — donnée de démonstration", recordedBy: sp.email, createdAt: semi + "T10:00:00.000Z" });
    dbInsertMany_("Payments", rows);
    audit_("SUBSCRIPTION_ASSIGNED", "Subscription", subId, org.organizationId, { planCode: "PRO", demo: true });
    out.subscriptions++; out.subscriptionPayments += rows.length;
  });
  // 1 bis. Identité du prestataire sur ses devis et factures ; un devis en attente et une intervention planifiée (hors ménage).
  const art = dbAll_("Artisans").find(function (c) { return String(c.organizationId) === platformOrgId_() && normalizeEmail_(c.email) === normalizeEmail_(DEMO_SPEC_.provider.email); });
  if (art && !art.legalName) dbUpdate_("Artisans", art.artisanId, { legalName: "Mohamed Zetounie — Multiservices (démo)", taxId: cur_() === "MAD" ? "ICE / IF / RC : à compléter" : "SIRET : à compléter — TVA non applicable, art. 293 B du CGI (exemple)",
    billingInfo: "Règlement par virement à réception de facture — RIB à compléter.", updatedAt: nowIso_() });
  const openIncident = function (title) { return dbAll_("IncidentsV4").find(function (i) { return i.title === title && ["OPEN", "QUOTE_PENDING", "ASSIGNED"].indexOf(i.status) >= 0; }); };
  const ac = openIncident("Bruit anormal du climatiseur du séjour"), bed = openIncident("Pied de lit cassé (chambre 2)");
  const agEmail = normalizeEmail_(DEMO_SPEC_.agency.email);
  out.pendingQuote = 0; out.scheduledWorkOrder = 0;
  if (art && ac && !dbAll_("Quotes").some(function (q) { return String(q.incidentId) === String(ac.incidentId); })) {
    const lines = [{ description: "Diagnostic et démontage du ventilateur intérieur", quantity: 2, unitPrice: dm_(150), amount: 2 * dm_(150) }, { description: "Roulement de ventilateur (pièce)", quantity: 1, unitPrice: dm_(280), amount: dm_(280) },
      { description: "Nettoyage complet de l'unité intérieure", quantity: 1, unitPrice: dm_(200), amount: dm_(200) }, { description: "Déplacement", quantity: 1, unitPrice: dm_(100), amount: dm_(100) }];
    const htQ = sumBy_(lines, function (l) { return l.amount; }), split = computeInvoiceSplit_(htQ, 20, 15, 20), at = addDaysStr_(today, -2);
    dbInsert_("Quotes", { organizationId: ac.organizationId, propertyId: ac.propertyId, incidentId: ac.incidentId, artisanId: art.artisanId, status: "PENDING", currency: cur_(), totalAmount: split.amountTTC,
      validUntil: addDaysStr_(today, 28), linesJson: lines, createdAt: at + "T09:00:00.000Z", createdBy: agEmail, requestNote: "Bruit fort au démarrage, merci de chiffrer la réparation.",
      requestedAt: at + "T09:00:00.000Z", requestedBy: agEmail, submittedAt: addDaysStr_(today, -1) + "T16:00:00.000Z", amountHT: htQ, vatRate: 20, amountTTC: split.amountTTC, estimatedDays: 1,
      commissionRateEst: 15, commissionEstimate: split.commissionAmount });
    dbUpdate_("IncidentsV4", ac.incidentId, { status: "AWAITING_OWNER", contractorId: art.artisanId, estimatedCost: split.amountTTC, updatedAt: nowIso_() });
    out.pendingQuote = 1;
  }
  if (art && bed && !dbAll_("WorkOrders").some(function (w) { return String(w.incidentId) === String(bed.incidentId); })) {
    const day = addDaysStr_(today, 2);
    dbInsert_("WorkOrders", { organizationId: bed.organizationId, propertyId: bed.propertyId, incidentId: bed.incidentId, quoteId: "", artisanId: art.artisanId, status: "SCHEDULED",
      scheduledAt: localToDate_(day, "10:00").toISOString(), description: "Remplacer le pied de lit cassé et vérifier la stabilité du sommier.", report: "", invoiceFileId: "", createdAt: nowIso_(), createdBy: agEmail,
      updatedAt: nowIso_(), updatedBy: agEmail, title: "Réparation du lit (chambre 2)", desiredDate: day, acceptedAt: nowIso_(), commissionRate: 15, photoDocIdsJson: [] });
    dbUpdate_("IncidentsV4", bed.incidentId, { status: "ASSIGNED", contractorId: art.artisanId, assignedToUserId: art.userId || "", updatedAt: nowIso_() });
    out.scheduledWorkOrder = 1;
  }
  // 1 ter. Voyageurs complets (tous les occupants, nationalité, pièce d'identité).
  Object.assign(out, demoGuests_(ownerOrg, props, today));
  // 2. Listes de tâches par pièce pour chaque ménage validé de la démonstration.
  const ids = Object.keys(props).map(function (k) { return String(props[k].prop.propertyId); });
