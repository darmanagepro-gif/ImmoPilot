/* ---------- Compléments : abonnements avec historique, listes de tâches et photos avant / après des ménages ---------- */
/** Prix de l'option agences propre à l'abonnement de démonstration (MAD par agence et par mois). */
var DEMO_AGENCY_OPTION_ = 99; // MAD ; édition France : dm_(99)
function subSchemaReady_() { return dbHeaders_("Subscriptions").indexOf("agencyOptionPrice") >= 0; }
var DEMO_PHOTOS_ = {"sejour_avant": "", "sejour_apres": "", "cuisine_avant": "", "cuisine_apres": ""};

/** Chaque étape ne s'exécute que si elle n'a pas déjà été faite (relance sans doublon). */
function demoExtras_(sp, ownerOrg, agencyOrg, props, provU, start, today) {
  const out = { subscriptions: 0, subscriptionPayments: 0, checklists: 0, photos: 0 };
  // 1. Abonnement Pro du propriétaire depuis 6 mois, avec l'option agences (l'agence qu'il a créée n'a pas d'abonnement propre) :
