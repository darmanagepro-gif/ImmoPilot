  html += "<h2>Signatures</h2><table class='sign'><tr><td>Le prestataire<br><span class='muted'>" + escapeHtml_(art.name || "") + "</span></td><td>Le client — « Bon pour accord »<br><span class='muted'>" + escapeHtml_(client.name || "") + "</span></td></tr></table>";
