  openInc("duplex", "AC", "Bruit anormal du climatiseur du séjour", 600, 3, "OPEN");
  openInc("deux", "FURNITURE", "Pied de lit cassé (chambre 2)", 300, 1, "OPEN");

  /* ---------- 3. Autres dépenses : eau et électricité, consommables, assurance, taxe ---------- */
  for (let m = 5; m >= 0; m--) {
