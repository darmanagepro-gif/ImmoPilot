  const known = {}; dbAll_("Documents").forEach(function (d) { known[d.fileId] = true; });
  const docs = [];
  const reg = function (fileId, ownerType, ownerId, category, row) {
    if (!fileId || known[fileId]) return; known[fileId] = true;
