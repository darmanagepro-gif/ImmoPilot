    ["Début prévu", cleanDT_(m.startAt)], ["Fin prévue", cleanDT_(m.endAt)], ["Durée estimée", (m.estimatedMinutes || "—") + " min"], ["Priorité", ({ LOW: "Basse", NORMAL: "Normale", HIGH: "Haute", URGENT: "Urgente" })[m.priority || "NORMAL"] || m.priority],
