        type: "INVOICE_PENDING", organizationId: v.organizationId, title: "Facture en attente : " + x.prop.name, body: v.amountTTC + " MAD TTC" + (notes.indexOf("[ÉCART") === 0 ? " — écart avec le devis" : ""), link: "#invoices" });
