  const val = function (v) { return escapeHtml_(v || "") || "<span class='muted'>……………………………</span>"; };
  const age = function (d) { if (!d) return null; const t = todayStr_(); let y = Number(t.slice(0, 4)) - Number(d.slice(0, 4)); if (t.slice(5) < d.slice(5)) y--; return y; };
